{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "./hooks/cursor-agent-cockpit-relay.mjs" }],
    "sessionEnd": [{ "command": "./hooks/cursor-agent-cockpit-relay.mjs" }],
    "beforeSubmitPrompt": [{ "command": "./hooks/cursor-agent-cockpit-relay.mjs" }],
    "preToolUse": [{ "command": "./hooks/cursor-agent-cockpit-relay.mjs" }],
    "postToolUse": [{ "command": "./hooks/cursor-agent-cockpit-relay.mjs" }],
    "postToolUseFailure": [{ "command": "./hooks/cursor-agent-cockpit-relay.mjs" }],
    "beforeShellExecution": [
      {
        "command": "./hooks/cursor-agent-cockpit-relay.mjs",
        "timeout": 30
      }
    ],
    "stop": [{ "command": "./hooks/cursor-agent-cockpit-relay.mjs" }],
    "afterAgentThought": [{ "command": "./hooks/cursor-agent-cockpit-relay.mjs" }]
  }
}
